#!/bin/bash
# Egyszerű indító a mm-manager menühöz

MM_DIR="$HOME/mm-manager"

# Ellenőrzés, hogy létezik a könyvtár
if [ ! -d "$MM_DIR" ]; then
    echo "❌ A $MM_DIR könyvtár nem található!"
    exit 1
fi

# Futtatható jogok beállítása
chmod +x "$MM_DIR/mm-manager.sh"
chmod +x "$MM_DIR/"*.sh

# Indítás
"$MM_DIR/mm-manager.sh"
